# Configuración de Django
DEBUG=True
SECRET_KEY=django-insecure-change-this-in-production-lxia-be
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Base de datos PostgreSQL
# En Render, DATABASE_URL es inyectada automáticamente.
# Para desarrollo local con Postgres: postgresql://postgres:postgres@localhost:5432/lxia_db
DATABASE_URL=sqlite:///db.sqlite3

# Superusuario administrativo inicial (opcional, para despliegues automatizados)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@lxia.org
DJANGO_SUPERUSER_PASSWORD=cambiar_esta_clave_segura

# CORS
CORS_ALLOW_ALL=True
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# CSRF
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000,http://127.0.0.1:8000,https://*.onrender.com
